# Raw exports stay local — big, and the runner never needs them.
# NOTE: photos/processed/ and photos/posted/ are deliberately NOT ignored.
# The GitHub Actions runner uploads photos/processed/<file>, so it must be in git.
photos/raw/

# Backfilled copies of posts already live on Instagram. Display-only: the
# publisher never reads these, so committing ~100 of them would add megabytes
# to a public repo to duplicate what Instagram already serves.
photos/history/

.env
.venv/
__pycache__/
*.pyc
.cache/
tests/fixtures/
.pytest_cache/
.DS_Store
.curation.json

# Machine-local: absolute Homebrew paths, permission grants for this checkout.
.claude/settings.local.json
